{
  "name": "tether-vscode",
  "displayName": "Tether — Flowmodoro & Deep Work Companion",
  "description": "Flowmodoro timer, automatic context save-states, and cognitive anchoring for deep work, neurodivergent minds, and focus.",
  "version": "1.2.0",
  "publisher": "Phrozenn1",
  "icon": "images/icon.png",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phrozenn1/tether-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "neurodiversity",
    "adhd",
    "autism",
    "dyslexia",
    "flowmodoro",
    "timer",
    "focus",
    "pomodoro",
    "productivity",
    "context-switch"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tether.openHub",
        "title": "Open Tether Hub",
        "category": "Tether"
      },
      {
        "command": "tether.toggleFlow",
        "title": "Start / Pause Flow (Flowmodoro)",
        "category": "Tether"
      },
      {
        "command": "tether.microStart",
        "title": "5m Micro-Start (Break Initiation Barrier)",
        "category": "Tether"
      },
      {
        "command": "tether.resetFlow",
        "title": "Reset Flowmodoro Timer",
        "category": "Tether"
      },
      {
        "command": "tether.captureImpulse",
        "title": "Park Impulse / Side-Quest",
        "category": "Tether"
      },
      {
        "command": "tether.ramDumpManager",
        "title": "Working Memory / RAM-Dumps (Create / Edit / Delete)",
        "category": "Tether"
      },
      {
        "command": "tether.ramDump",
        "title": "Rapid RAM Dump (Park a Distracting Thought)",
        "category": "Tether"
      },
      {
        "command": "tether.shutdownRitual",
        "title": "Evening Shutdown Ritual",
        "category": "Tether"
      },
      {
        "command": "tether.openDesktop",
        "title": "Open Tether Desktop",
        "category": "Tether"
      }
    ],
    "configuration": {
      "title": "Tether",
      "properties": {
        "tether.autoAnchor": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save active file, cursor position, and git branch as context anchor for Tether"
        },
        "tether.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Flowmodoro status bar widget in VS Code"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
