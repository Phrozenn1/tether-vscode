{
  "name": "tether-vscode",
  "displayName": "Tether — ADHD Flow & Save-State",
  "description": "ADHD Flowmodoro timer, automatic context save-states, and distraction shielding for VS Code.",
  "version": "0.1.1",
  "publisher": "Phrozenn1",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phrozenn1/tether-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "adhd",
    "flowmodoro",
    "timer",
    "focus",
    "pomodoro",
    "productivity",
    "context-switch"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tether.toggleFlow",
        "title": "Start / Pause Flow (Flowmodoro)",
        "category": "Tether"
      },
      {
        "command": "tether.microStart",
        "title": "5m Micro-Start (Break Initiation Barrier)",
        "category": "Tether"
      },
      {
        "command": "tether.ramDump",
        "title": "Rapid RAM Dump (Park a Distracting Thought)",
        "category": "Tether"
      },
      {
        "command": "tether.openDesktop",
        "title": "Open Tether Desktop",
        "category": "Tether"
      }
    ],
    "configuration": {
      "title": "Tether",
      "properties": {
        "tether.autoAnchor": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save active file, cursor position, and git branch as context anchor for Tether"
        },
        "tether.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Flowmodoro status bar widget in VS Code"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
